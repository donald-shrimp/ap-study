[
  {
    "id": "fp2-202605-jafp-q01",
    "qualificationId": "fp2",
    "examPartId": "jafp-practical",
    "topicId": "life-planning",
    "version": 1,
    "status": "draft",
    "title": "ＦＰ関連業法・○×４欄",
    "source": "日本FP協会・2026年公表分・2級実技試験（資産設計提案業務）・公式問題を文字起こしし個別解説を加筆",
    "body": "ファイナンシャル・プランナー（以下「ＦＰ」という）は、ファイナンシャル・プランニング業務を行ううえで関連業法等を順守することが重要である。ＦＰの行為に関する次の（ア）～（エ）の記述について、適切なものは○、不適切なものは×を選択しなさい。なお、記載のない資格の登録等については一切考慮しないものとする。\n\n（ア）弁護士の登録を受けていないＦＰが、顧客から離婚後の生活設計等について相談を受け、その顧客の代理人として相手方との離婚時の財産分与について協議を行い、報酬を受け取った。\n\n（イ）弁護士または司法書士の登録を受けていないＦＰが、相続財産である不動産の登記申請を代行した。\n\n（ウ）金融商品取引業の登録を受けていないＦＰが、資産運用を検討している顧客に対し、ＮＩＳＡ（少額投資非課税制度）の仕組みを説明した。\n\n（エ）税理士の登録を受けていないＦＰが、参加費有料の相続対策セミナーで、仮定の事例に基づく一般的な解説を行い、講師料を受け取った。",
    "sourceImages": [],
    "bodyFigures": [],
    "items": [
      {
        "id": "item1",
        "label": "問1",
        "prompt": "（ア）～（エ）の各行為が適切か、回答欄ごとに○または×を選ぶ。",
        "fields": [
          {
            "id": "a",
            "label": "（ア）財産分与交渉の代理",
            "type": "singleChoice",
            "grading": {
              "method": "exactText"
            },
            "referenceAnswers": [
              "×"
            ],
            "choices": [
              {
                "id": "choice1",
                "label": "○",
                "text": "適切"
              },
              {
                "id": "choice2",
                "label": "×",
                "text": "不適切"
              }
            ],
            "explanation": "法律事件の代理交渉を報酬目的で行うことは、原則として弁護士資格が必要な非弁行為に当たり、ＦＰの一般的な生活設計相談の範囲を超える。",
            "rubric": [
              "生活設計の一般相談と、相手方との代理交渉を区別する。"
            ]
          },
          {
            "id": "i",
            "label": "（イ）相続不動産の登記申請代行",
            "type": "singleChoice",
            "grading": {
              "method": "exactText"
            },
            "referenceAnswers": [
              "×"
            ],
            "choices": [
              {
                "id": "choice1",
                "label": "○",
                "text": "適切"
              },
              {
                "id": "choice2",
                "label": "×",
                "text": "不適切"
              }
            ],
            "explanation": "他人の依頼を受け報酬を得て登記申請代理を業として行うには、原則として司法書士等の法定資格が必要である。ＦＰ資格だけでは登記申請を代行できない。",
            "rubric": [
              "不動産の一般的な相談と登記代理業務を区別する。"
            ]
          },
          {
            "id": "u",
            "label": "（ウ）ＮＩＳＡ制度の一般的説明",
            "type": "singleChoice",
            "grading": {
              "method": "exactText"
            },
            "referenceAnswers": [
              "○"
            ],
            "choices": [
              {
                "id": "choice1",
                "label": "○",
                "text": "適切"
              },
              {
                "id": "choice2",
                "label": "×",
                "text": "不適切"
              }
            ],
            "explanation": "ＮＩＳＡの仕組みの一般的な説明は、特定の有価証券の売買勧誘や投資助言契約に基づく個別助言ではないため、金融商品取引業登録なしでも行える。",
            "rubric": [
              "制度説明と登録を要する具体的な投資助言・勧誘を区別する。"
            ]
          },
          {
            "id": "e",
            "label": "（エ）仮定の事例による有料セミナー",
            "type": "singleChoice",
            "grading": {
              "method": "exactText"
            },
            "referenceAnswers": [
              "○"
            ],
            "choices": [
              {
                "id": "choice1",
                "label": "○",
                "text": "適切"
              },
              {
                "id": "choice2",
                "label": "×",
                "text": "不適切"
              }
            ],
            "explanation": "仮定の事例に基づく一般的な相続税制度の解説は、特定人の具体的税務相談や税務書類作成の代理とは異なり、税理士資格のないＦＰでも行える。",
            "rubric": [
              "一般的な制度解説と、特定人の税務代理・個別税務相談を区別する。"
            ]
          }
        ]
      }
    ],
    "sourceRecord": {
