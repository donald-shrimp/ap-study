{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://donald-shrimp.github.io/ap-study/schemas/study-plan.v2.json",
  "title": "ひと問 StudyPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "qualificationId",
    "timeZone",
    "examDates",
    "phases"
  ],
  "properties": {
    "format": {
      "const": "hitomon-study-plan"
    },
    "version": {
      "const": 2
    },
    "qualificationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
      "maxLength": 100
    },
    "timeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "examDates": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "examPartId",
          "date"
        ],
        "properties": {
          "examPartId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
            "maxLength": 100
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "phases": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "start",
          "end",
          "examPartIds",
          "goals",
          "focusTopicIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "start": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "end": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "examPartIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
              "maxLength": 100
            }
          },
          "focusTopicIds": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
              "maxLength": 100
            }
          },
          "weeklyTargets": {
            "type": "array",
            "maxItems": 104,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "start",
                "end",
                "goals"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
                  "maxLength": 100
                },
                "start": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "end": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "goals": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "examPartId",
                      "unit",
                      "target"
                    ],
                    "properties": {
                      "examPartId": {
                        "type": "string",
                        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
                      },
                      "unit": {
                        "enum": [
                          "questionAttempts",
                          "cases"
                        ]
                      },
                      "target": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100000
                      }
                    }
                  }
                }
              }
            }
          },
          "milestones": {
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "date",
                "examPartId",
                "completed"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
                  "maxLength": 100
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "examPartId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$",
                  "maxLength": 100
                },
                "completed": {
                  "type": "boolean"
                }
              }
            }
          },
          "goals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "examPartId",
                "unit",
                "target"
              ],
              "properties": {
                "examPartId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"
                },
                "unit": {
                  "enum": [
                    "questionAttempts",
                    "cases"
                  ]
                },
                "target": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100000
                }
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "studiedScope": {
          "type": "string",
          "maxLength": 2000
        },
        "materials": {
          "type": "string",
          "maxLength": 2000
        },
        "constraints": {
          "type": "string",
          "maxLength": 2000
        },
        "rationale": {
          "type": "string",
          "maxLength": 2000
        },
        "weeklyMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "updatedOn": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  },
  "$comment": "2026-10-07: optional phase weeklyTargets and milestones added; existing required fields and their meanings are unchanged. Date references, bounds, overlap and totals are checked by the app. Optional plan context added: user-provided assumptions, omitted on import preserves current context; {} explicitly clears it."
}
