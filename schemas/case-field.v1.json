{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://donald-shrimp.github.io/ap-study/schemas/case-field.v1.json",
  "title": "共通本文の回答欄",
  "type": "object",
  "required": [
    "id",
    "label",
    "type",
    "grading",
    "explanation",
    "rubric"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "label": {
      "type": "string",
      "maxLength": 100
    },
    "type": {
      "enum": [
        "singleChoice",
        "shortText",
        "freeText",
        "numeric",
        "answerSet"
      ]
    },
    "maxLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "referenceAnswers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "explanation": {
      "type": "string"
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "string"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "choices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
          },
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "numeric": {
      "type": "object",
      "required": [
        "unit",
        "decimalPlaces",
        "rounding"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "decimalPlaces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12
        },
        "rounding": {
          "enum": [
            "none",
            "halfUp",
            "floor",
            "ceil",
            "truncate"
          ]
        }
      },
      "additionalProperties": false
    },
    "answerSet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceFieldIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
          }
        },
        "slots": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          }
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "grading": {
      "type": "object",
      "required": [
        "method"
      ],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string"
        }
      }
    },
    "correctChoiceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "singleChoice"
        },
        "grading": {
          "properties": {
            "method": {
              "enum": [
                "exactText",
                "exactChoiceSet"
              ]
            }
          }
        },
        "correctChoiceIds": {
          "maxItems": 1
        }
      },
      "required": [
        "choices"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "shortText"
        },
        "grading": {
          "properties": {
            "method": {
              "enum": [
                "exactText",
                "self"
              ]
            }
          }
        }
      },
      "required": [
        "maxLength"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "freeText"
        },
        "grading": {
          "properties": {
            "method": {
              "enum": [
                "self"
              ]
            }
          }
        }
      },
      "required": [
        "maxLength"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "numeric"
        },
        "grading": {
          "properties": {
            "method": {
              "enum": [
                "exactDecimal"
              ]
            }
          }
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "numeric",
        "maxLength"
      ]
    },
    {
      "properties": {
        "type": {
          "const": "answerSet"
        },
        "grading": {
          "properties": {
            "method": {
              "enum": [
                "unordered",
                "exactChoiceSet"
              ]
            }
          }
        },
        "referenceAnswers": {
          "uniqueItems": true
        }
      },
      "required": [
        "answerSet"
      ]
    }
  ],
  "$comment": "数値の正答は単位・区切りなしの十進文字列。入力への自動丸めや単位換算は行わない。",
  "allOf": [
    {
      "if": {
        "properties": {
          "grading": {
            "properties": {
              "method": {
                "const": "exactChoiceSet"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "choices",
          "correctChoiceIds"
        ],
        "not": {
          "required": [
            "referenceAnswers"
          ]
        }
      },
      "else": {
        "required": [
          "referenceAnswers"
        ],
        "not": {
          "required": [
            "correctChoiceIds"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "singleChoice",
              "answerSet"
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "choices"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "answerSet"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "answerSet"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "numeric"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "numeric"
          ]
        }
      }
    }
  ]
}
