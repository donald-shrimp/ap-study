rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function mine(uid) { return request.auth != null && request.auth.uid == uid; }
  function completed(p) { return p.status in ['correct','assisted','incorrect','revealed']; }
  function valid(p, id, qualificationId) {
   return p.keys().hasOnly(['id','qualificationId','questionId','questionVersion','contentRevision','topic','topicId','readingNote','status','startedAt','updatedAt','completedAt','selected','selectedChoiceId','hintCount','hintsBeforeAnswer','hintEvents','answerViewedBefore','confidence','questionSnapshot','materialSnapshot','continuationOf','continuedAt','importedFrom'])
    && p.id == id && p.qualificationId == qualificationId
    && p.questionId is string && p.questionVersion is int && p.contentRevision is string
    && p.status in ['in_progress','postponed','correct','assisted','incorrect','revealed']
    && p.startedAt is string && p.updatedAt is string
    && p.confidence is bool && p.answerViewedBefore is bool
    && p.questionSnapshot is map && p.questionSnapshot.id == p.questionId
    && p.questionSnapshot.qualificationId == qualificationId
    && !('diagnosticOnly' in p.questionSnapshot)
    && p.materialSnapshot is map && p.materialSnapshot.hints is list
    && p.materialSnapshot.hints.size() >= 1 && p.materialSnapshot.hints.size() <= 20
    && p.hintCount is int && p.hintCount >= 0 && p.hintCount <= p.materialSnapshot.hints.size()
    && p.hintEvents is list && p.hintEvents.size() == p.hintCount
    && p.questionSnapshot.choices is list && p.questionSnapshot.choices.size() >= 2 && p.questionSnapshot.choices.size() <= 20
    && p.questionSnapshot.answer is int && p.questionSnapshot.answer >= 0 && p.questionSnapshot.answer < p.questionSnapshot.choices.size()
    && (p.selected == null || p.selected is int && p.selected >= 0 && p.selected < p.questionSnapshot.choices.size())
    && p.selectedChoiceId == (p.selected == null ? null : p.questionSnapshot.choices[p.selected].id)
    && (completed(p) ? p.completedAt is string && p.hintsBeforeAnswer is int && p.hintsBeforeAnswer >= 0 && p.hintsBeforeAnswer <= p.hintCount : p.completedAt == null && p.hintsBeforeAnswer == null)
    && (p.status != 'correct' || p.selected == p.questionSnapshot.answer && p.hintsBeforeAnswer == 0 && !p.answerViewedBefore)
    && (p.status != 'assisted' || p.selected == p.questionSnapshot.answer && p.hintsBeforeAnswer > 0 && !p.answerViewedBefore)
    && (p.status != 'incorrect' || p.selected != null && p.selected != p.questionSnapshot.answer && !p.answerViewedBefore)
    && (p.status != 'revealed' || p.answerViewedBefore);
  }
  function envelope(id, qualificationId) {
   let d = request.resource.data;
   return d.keys().hasOnly(['version','deviceId','revision','operationId','payload','updatedAt'])
    && d.version == 1 && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && d.revision is int && d.revision >= 1
    && d.operationId == id + ':' + string(d.revision)
    && d.updatedAt == request.time && valid(d.payload, id, qualificationId);
  }
  function validDiagnostic(p, id, qualificationId) {
   return p.keys().hasOnly(['id','qualificationId','version','blueprintVersion','selectionPolicy','catalogRevision','assistance','feedback','size','status','startedAt','completedAt','currentIndex','currentChoiceId','responses','slots'])
    && p.id == id && p.qualificationId == qualificationId && p.version == 1
    && p.assistance == 'none' && p.feedback == 'after-finish' && p.size == 30
    && p.status in ['in_progress','completed','ended_early']
    && p.startedAt is string && (p.status == 'in_progress' ? p.completedAt == null : p.completedAt is string)
    && p.currentIndex is int && p.currentIndex >= 0 && p.currentIndex < 30
    && p.responses is map && p.responses.size() <= 30
    && (p.currentChoiceId == null || p.currentChoiceId is string)
    && p.slots is list && p.slots.size() == 30;
  }
  function frozenDiagnostic(p, old) {
   return p.diff(old).affectedKeys().hasOnly(['responses','currentChoiceId','status','currentIndex','completedAt'])
    && p.slots == old.slots && p.currentIndex >= old.currentIndex
    && p.responses.diff(old.responses).removedKeys().size() == 0
    && p.responses.diff(old.responses).changedKeys().size() == 0;
  }
  function validPlanContext(c) {
   return c is map && c.keys().hasOnly(['studiedScope','materials','weeklyMinutes','constraints','rationale','updatedOn'])
    && (!('studiedScope' in c) || c.studiedScope is string && c.studiedScope.size() <= 2000)
    && (!('materials' in c) || c.materials is string && c.materials.size() <= 2000)
    && (!('constraints' in c) || c.constraints is string && c.constraints.size() <= 2000)
    && (!('rationale' in c) || c.rationale is string && c.rationale.size() <= 2000)
    && (!('weeklyMinutes' in c) || c.weeklyMinutes is int && c.weeklyMinutes >= 0 && c.weeklyMinutes <= 10080)
    && (!('updatedOn' in c) || c.updatedOn is string && c.updatedOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
  }
  function validPlan(p, qualificationId) {
   return p.keys().hasOnly(['format','version','qualificationId','timeZone','examDates','phases','context'])
    && p.format == 'hitomon-study-plan' && p.version == 1 && p.qualificationId == qualificationId
    && (!('context' in p) || validPlanContext(p.context))
    && p.timeZone is string && p.timeZone.size() > 0 && p.timeZone.size() <= 80
    && p.examDates is list && p.examDates.size() <= 20 && p.phases is list && p.phases.size() <= 24;
  }
  function resourceEnvelope(id, qualificationId) {
   let d = request.resource.data;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt'])
    && d.version == 1 && d.kind in ['planning','diagnostic']
    && d.revision is int && d.revision >= 1 && d.operationId is string && d.operationId.size() <= 300
    && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && d.updatedAt == request.time
    && (d.kind == 'planning' ? id == 'planning' && validPlan(d.payload, qualificationId) : validDiagnostic(d.payload, id, qualificationId));
  }
  match /users/{uid}/qualifications/{qualificationId}/resources/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && resourceEnvelope(id, qualificationId) && request.resource.data.revision == 1;
   allow update: if mine(uid) && resourceEnvelope(id, qualificationId)
    && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.kind == resource.data.kind
    && (resource.data.kind == 'planning' || (resource.data.payload.status == 'in_progress'
     ? frozenDiagnostic(request.resource.data.payload, resource.data.payload)
     : request.resource.data.payload == resource.data.payload));
   allow delete: if false;
  }
  function validLearning(p, kind, id) {
   return kind in ['desk','deferred']
    ? p.keys().hasOnly(['questionId','value']) && p.questionId is string && p.questionId.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}') && p.value is bool && id == kind + '--' + p.questionId
    : kind == 'context' && p.keys().hasOnly(['attemptId','questionId','entryMode','scope'])
     && p.attemptId is string && p.attemptId.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}')
     && p.questionId is string && p.questionId.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}')
     && id == 'context--' + p.attemptId && p.entryMode in ['all','paperless','desk']
     && p.scope is map && p.scope.keys().hasOnly(['intent','topicId','topicIds','examPartId','examPartIds','paperMode','returnView','returnRunId'])
     && p.scope.intent in ['normal','topic','review','direct'] && p.scope.paperMode == p.entryMode
     && (p.scope.topicId == null || p.scope.topicId is string && p.scope.topicId.size() <= 100)
     && (p.scope.examPartId == null || p.scope.examPartId is string && p.scope.examPartId.size() <= 100)
     && (p.scope.returnRunId == null || p.scope.returnRunId is string && p.scope.returnRunId.size() <= 100)
     && p.scope.topicIds is list && p.scope.topicIds.size() <= 100
     && p.scope.examPartIds is list && p.scope.examPartIds.size() <= 100
     && p.scope.returnView in ['home','topics','review','history','materials','flashcards','study','diagnostic','diagnostics','planning'];
  }
  function learningEnvelope(id) {
   let d=request.resource.data;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt'])
    && d.version == 1 && d.kind in ['desk','deferred','context']
    && d.revision is int && d.revision >= 1 && d.updatedAt == request.time
    && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && d.operationId is string && d.operationId.size() > 0 && d.operationId.size() <= 300
    && validLearning(d.payload,d.kind,id);
  }
  match /users/{uid}/qualifications/{qualificationId}/learning/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && learningEnvelope(id) && request.resource.data.revision == 1;
   allow update: if mine(uid) && learningEnvelope(id) && request.resource.data.kind == resource.data.kind && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if false;
  }
  function cardId(v) { return v is string && v.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}'); }
  function cardIds(v) { return v is list && v.size() > 0 && v.size() <= 200 && v.toSet().size() == v.size(); }
  function cardEnvelope(id) {
   let d=request.resource.data;
   let p=d.payload;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt'])
    && d.version == 1 && d.revision == 1 && d.operationId == id && d.updatedAt == request.time
    && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && cardId(p.id) && id == d.kind + '--' + p.id
    && (d.kind == 'rating'
     ? p.keys().hasOnly(['id','cardId','cardVersion','outcome','at']) && cardId(p.cardId)
      && p.cardVersion is int && p.cardVersion > 0 && p.outcome in ['recalled','again']
      && p.at is string && p.at.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z')
     : (d.kind == 'reset' ? p.keys().hasOnly(['id','eventIds']) && cardIds(p.eventIds)
       : d.kind == 'restore' && p.keys().hasOnly(['id','eventIds','resetIds']) && cardIds(p.eventIds) && cardIds(p.resetIds)));
  }
  match /users/{uid}/qualifications/{qualificationId}/cards/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && cardEnvelope(id);
   allow update, delete: if false;
  }
  match /users/{uid}/qualifications/{qualificationId}/attempts/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && envelope(id, qualificationId);
   allow update: if mine(uid) && envelope(id, qualificationId)
    && request.resource.data.deviceId == resource.data.deviceId
    && request.resource.data.revision > resource.data.revision
    && request.resource.data.payload.hintCount >= resource.data.payload.hintCount
    && request.resource.data.payload.questionSnapshot == resource.data.payload.questionSnapshot
    && request.resource.data.payload.materialSnapshot == resource.data.payload.materialSnapshot
    && request.resource.data.payload.startedAt == resource.data.payload.startedAt
    && request.resource.data.payload.questionId == resource.data.payload.questionId
    && (!completed(resource.data.payload) || request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['hintCount','hintEvents','updatedAt']));
   // Removing local history is local only. Destructive cloud reset is not offered.
   allow delete: if false;
  }
 }
}
