rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function mine(uid) { return request.auth != null && request.auth.uid == uid; }
  function completed(p) { return p.evaluation != null; }
  function choiceIds(q) {
   // Rules cannot map a list: choices are bounded at 20 by the shared contract.
   return [q.choices[0].id, q.choices[1].id,
    q.choices.size() > 2 ? q.choices[2].id : null,
    q.choices.size() > 3 ? q.choices[3].id : null,
    q.choices.size() > 4 ? q.choices[4].id : null,
    q.choices.size() > 5 ? q.choices[5].id : null,
    q.choices.size() > 6 ? q.choices[6].id : null,
    q.choices.size() > 7 ? q.choices[7].id : null,
    q.choices.size() > 8 ? q.choices[8].id : null,
    q.choices.size() > 9 ? q.choices[9].id : null,
    q.choices.size() > 10 ? q.choices[10].id : null,
    q.choices.size() > 11 ? q.choices[11].id : null,
    q.choices.size() > 12 ? q.choices[12].id : null,
    q.choices.size() > 13 ? q.choices[13].id : null,
    q.choices.size() > 14 ? q.choices[14].id : null,
    q.choices.size() > 15 ? q.choices[15].id : null,
    q.choices.size() > 16 ? q.choices[16].id : null,
    q.choices.size() > 17 ? q.choices[17].id : null,
    q.choices.size() > 18 ? q.choices[18].id : null,
    q.choices.size() > 19 ? q.choices[19].id : null];
  }
  function validIds(ids,available) {
   return ids is list && ids.size() <= 20 && ids.toSet().size() == ids.size()
    && !ids.hasAny([null]) && ids.hasOnly(available);
  }
  function submitted(p) { return p.response.choiceIds.size() > 0 && (p.material.type == 'singleChoice' || p.material.selection.mode == 'all' || p.response.choiceIds.size() == p.material.selection.count); }
  function right(p) { return p.response.choiceIds.toSet() == p.material.correctChoiceIds.toSet(); }
  function valid(p,id,qualificationId) {
   let q=p.material;
   let a=p.assistance;
   let e=p.evaluation;
   let available=choiceIds(q);
   let isRight=p.response.choiceIds.toSet() == q.correctChoiceIds.toSet();
   return p.keys().hasOnly(['format','version','id','qualificationId','examPartId','kind','questionId','questionVersion','contentRevision','material','lesson','response','evaluation','assistance','progress','startedAt','updatedAt','continuationOf','continuedAt','importedFrom'])
    && p.format == 'hitomon-learning-record' && p.version == 2 && p.kind == 'question' && p.id == id && p.qualificationId == qualificationId
    && p.examPartId is string && p.questionId is string && p.questionVersion is int && p.contentRevision is string
    && p.startedAt is string && p.updatedAt is string && p.progress.status in ['in_progress','postponed','completed']
    && q is map && q.id == p.questionId && q.version == p.questionVersion && q.qualificationId == qualificationId && q.examPartId == p.examPartId
    && !('answer' in q) && !('correctChoiceId' in q) && !('diagnosticOnly' in q)
    && (!('uses' in q) || q.uses is list && q.uses.hasOnly(['practice','diagnostic','mock']) && q.uses.hasAny(['practice']))
    && q.choices is list && q.choices.size() >= 2 && q.choices.size() <= 20
    && validIds(q.correctChoiceIds,available) && q.correctChoiceIds.size() > 0
    && p.response.keys().hasOnly(['choiceIds']) && validIds(p.response.choiceIds,available)
    && (q.type == 'singleChoice' ? q.correctChoiceIds.size() == 1 && p.response.choiceIds.size() <= 1 : q.type == 'multipleChoice' && q.selection is map && (q.selection.mode == 'all' || q.selection.mode == 'exact' && q.selection.count == q.correctChoiceIds.size()))
    && p.lesson is map && p.lesson.hints is list && p.lesson.hints.size() <= 20
    && a.keys().hasOnly(['hintCount','hintEvents','answerViewedBefore']) && a.answerViewedBefore is bool
    && a.hintCount is int && a.hintCount >= 0 && a.hintCount <= p.lesson.hints.size() && a.hintEvents is list && a.hintEvents.size() == a.hintCount
    && (e == null ? p.progress.status != 'completed' : e.keys().hasOnly(['source','outcome','at','hintsBeforeAnswer']) && p.progress.status == 'completed' && e.source == 'automatic' && e.at is string && e.hintsBeforeAnswer is int && e.hintsBeforeAnswer >= 0 && e.hintsBeforeAnswer <= a.hintCount
      && (e.outcome == 'correct' && isRight && e.hintsBeforeAnswer == 0 && !a.answerViewedBefore
       || e.outcome == 'assisted' && isRight && e.hintsBeforeAnswer > 0 && !a.answerViewedBefore
       || e.outcome == 'incorrect' && submitted(p) && !isRight && !a.answerViewedBefore
       || e.outcome == 'revealed' && a.answerViewedBefore));
  }
  function envelope(id, qualificationId) {
   let d = request.resource.data;
   return d.keys().hasOnly(['version','deviceId','revision','operationId','payload','updatedAt'])
    && d.version == 2 && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && d.revision is int && d.revision >= 1
    && d.operationId == id + ':' + string(d.revision)
    && d.updatedAt == request.time && valid(d.payload, id, qualificationId);
  }
  function validDiagnostic(p, id, qualificationId) {
   return p.keys().hasOnly(['format','id','qualificationId','version','blueprintVersion','selectionPolicy','catalogRevision','assistance','feedback','size','status','startedAt','completedAt','currentIndex','currentResponse','responses','slots'])
    && p.id == id && p.qualificationId == qualificationId && p.version == 2
    && p.assistance == 'none' && p.feedback == 'after-finish' && p.size is int && p.size >= 30 && p.size <= 200
    && p.status in ['in_progress','completed','ended_early']
    && p.startedAt is string && (p.status == 'in_progress' ? p.completedAt == null : p.completedAt is string)
    && p.currentIndex is int && p.currentIndex >= 0 && p.currentIndex < p.size
    && p.responses is map && p.responses.size() <= p.size
    && p.format == 'hitomon-assessment' && p.currentResponse is map && p.currentResponse.keys().hasOnly(['choiceIds']) && p.currentResponse.choiceIds is list && p.currentResponse.choiceIds.size() <= 20
    && p.slots is list && p.slots.size() == p.size;
  }
  function validMock(p, id, qualificationId) {
   return p.keys().hasOnly(['format','id','qualificationId','version','mode','mockSet','blueprintVersion','selectionPolicy','catalogRevision','assistance','feedback','size','status','startedAt','completedAt','currentIndex','currentResponse','responses','slots'])
    && p.id == id && p.qualificationId == qualificationId && p.version == 2 && p.mode == 'mock'
    && p.assistance == 'none' && p.feedback == 'after-finish' && p.size is int && p.size >= 1 && p.size <= 200 && p.selectionPolicy == null
    && p.mockSet is map && p.mockSet.keys().hasOnly(['id','label','version','questionIds'])
    && p.mockSet.id is string && p.mockSet.id.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}')
    && p.mockSet.label is string && p.mockSet.label.size() > 0 && p.mockSet.label.size() <= 200
    && p.mockSet.version is int && p.mockSet.version > 0
    && p.mockSet.questionIds is list && p.mockSet.questionIds.size() == p.size
    && p.status in ['in_progress','completed','ended_early']
    && p.startedAt is string && (p.status == 'in_progress' ? p.completedAt == null : p.completedAt is string)
    && p.currentIndex is int && p.currentIndex >= 0 && p.currentIndex < p.size
    && p.responses is map && p.responses.size() <= p.size
    && p.format == 'hitomon-assessment' && p.currentResponse is map && p.currentResponse.keys().hasOnly(['choiceIds']) && p.currentResponse.choiceIds is list && p.currentResponse.choiceIds.size() <= 20
    && p.slots is list && p.slots.size() == p.size;
  }
  function frozenDiagnostic(p, old) {
   return p.diff(old).affectedKeys().hasOnly(['responses','currentResponse','status','currentIndex','completedAt'])
    && p.slots == old.slots && p.currentIndex >= old.currentIndex
    && p.responses.diff(old.responses).removedKeys().size() == 0
    && p.responses.diff(old.responses).changedKeys().size() == 0;
  }
  function validPlanContext(c) {
   return c is map && c.keys().hasOnly(['studiedScope','materials','weeklyMinutes','constraints','rationale','updatedOn'])
    && (!('studiedScope' in c) || c.studiedScope is string && c.studiedScope.size() <= 2000)
    && (!('materials' in c) || c.materials is string && c.materials.size() <= 2000)
    && (!('constraints' in c) || c.constraints is string && c.constraints.size() <= 2000)
    && (!('rationale' in c) || c.rationale is string && c.rationale.size() <= 2000)
    && (!('weeklyMinutes' in c) || c.weeklyMinutes is int && c.weeklyMinutes >= 0 && c.weeklyMinutes <= 10080)
    && (!('updatedOn' in c) || c.updatedOn is string && c.updatedOn.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'));
  }
  function validPlan(p, qualificationId) {
   return p.keys().hasOnly(['format','version','qualificationId','timeZone','examDates','phases','context'])
    && p.format == 'hitomon-study-plan' && p.version == 2 && p.qualificationId == qualificationId
    && (!('context' in p) || validPlanContext(p.context))
    && p.timeZone is string && p.timeZone.size() > 0 && p.timeZone.size() <= 80
    && p.examDates is list && p.examDates.size() <= 20 && p.phases is list && p.phases.size() <= 24;
  }
  function resourceEnvelope(id, qualificationId) {
   let d = request.resource.data;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt'])
    && d.version == 2 && d.kind in ['planning','diagnostic','mock','planRevision']
    && d.revision is int && d.revision >= 1 && d.operationId is string && d.operationId.size() <= 300
    && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && d.updatedAt == request.time
    && (d.kind == 'planning' ? id == 'planning' && validPlan(d.payload, qualificationId) : d.kind == 'planRevision' ? validPlanRevision(d.payload, id, qualificationId) : d.kind == 'mock' ? validMock(d.payload, id, qualificationId) : validDiagnostic(d.payload, id, qualificationId));
  }
  function validPlanRevision(p, id, qualificationId) {
   return p.keys().hasOnly(['format','version','id','qualificationId','savedAt','origin','previousId','plan'])
    && p.format == 'hitomon-plan-revision' && p.version == 2 && p.id == id
    && id.matches('plan--[a-zA-Z0-9_-]{1,90}') && p.qualificationId == qualificationId
    && p.savedAt is string && p.savedAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z')
    && p.origin in ['registered','edited','imported','baseline','resolved','restored']
    && (p.previousId == null || p.previousId is string && p.previousId.matches('plan--[a-zA-Z0-9_-]{1,90}') && p.previousId != id)
    && validPlan(p.plan, qualificationId);
  }
  match /users/{uid}/qualifications/{qualificationId}/resourcesV2/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && resourceEnvelope(id, qualificationId) && request.resource.data.revision == 1;
   allow update: if mine(uid) && resourceEnvelope(id, qualificationId)
    && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.kind == resource.data.kind
    && (resource.data.kind == 'planning' || (resource.data.kind == 'planRevision' ? request.resource.data.payload == resource.data.payload : resource.data.payload.status == 'in_progress'
     ? frozenDiagnostic(request.resource.data.payload, resource.data.payload)
     : request.resource.data.payload == resource.data.payload));
   allow delete: if false;
  }
  function validLearning(p, kind, id) {
   return kind in ['desk','deferred']
    ? p.keys().hasOnly(['questionId','value']) && p.questionId is string && p.questionId.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}') && p.value is bool && id == kind + '--' + p.questionId
    : kind == 'context' && p.keys().hasOnly(['attemptId','questionId','entryMode','scope'])
     && p.attemptId is string && p.attemptId.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}')
     && p.questionId is string && p.questionId.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}')
     && id == 'context--' + p.attemptId && p.entryMode in ['all','paperless','desk']
     && p.scope is map && p.scope.keys().hasOnly(['intent','topicId','topicIds','examPartId','examPartIds','paperMode','returnView','returnRunId'])
     && p.scope.intent in ['normal','topic','review','direct'] && p.scope.paperMode == p.entryMode
     && (p.scope.topicId == null || p.scope.topicId is string && p.scope.topicId.size() <= 100)
     && (p.scope.examPartId == null || p.scope.examPartId is string && p.scope.examPartId.size() <= 100)
     && (p.scope.returnRunId == null || p.scope.returnRunId is string && p.scope.returnRunId.size() <= 100)
     && p.scope.topicIds is list && p.scope.topicIds.size() <= 100
     && p.scope.examPartIds is list && p.scope.examPartIds.size() <= 100
     && p.scope.returnView in ['home','topics','review','history','materials','flashcards','study','diagnostic','diagnostics','planning'];
  }
  function learningEnvelope(id) {
   let d=request.resource.data;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt'])
    && d.version == 2 && d.kind in ['desk','deferred','context']
    && d.revision is int && d.revision >= 1 && d.updatedAt == request.time
    && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && d.operationId is string && d.operationId.size() > 0 && d.operationId.size() <= 300
    && validLearning(d.payload,d.kind,id);
  }
  match /users/{uid}/qualifications/{qualificationId}/learningV2/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && learningEnvelope(id) && request.resource.data.revision == 1;
   allow update: if mine(uid) && learningEnvelope(id) && request.resource.data.kind == resource.data.kind && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if false;
  }
  function validPersonal(p,kind,id,deviceId) {
   return kind == 'note'
    ? p.keys().hasOnly(['topicId','text']) && cardId(p.topicId) && id == 'note--' + p.topicId && p.text is string && p.text.size() <= 200
    : kind == 'checkpoint' && p.keys().hasOnly(['deviceId','checkpoint','at']) && cardId(p.deviceId) && p.deviceId == deviceId && id == 'checkpoint--' + p.deviceId
     && p.at is string && p.at.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z')
     && (p.checkpoint == null || p.checkpoint is map
      && p.checkpoint.keys().hasOnly(['cardId','cardVersion','flipped','seen','recent','topicId'])
      && cardId(p.checkpoint.cardId) && p.checkpoint.cardVersion is int && p.checkpoint.cardVersion > 0 && p.checkpoint.flipped is bool
      && p.checkpoint.seen is list && p.checkpoint.seen.size() <= 10000 && p.checkpoint.seen.toSet().size() == p.checkpoint.seen.size()
      && p.checkpoint.recent is list && p.checkpoint.recent.size() <= 10
      && (p.checkpoint.topicId == null || cardId(p.checkpoint.topicId)));
  }
  function personalEnvelope(id) {
   let d=request.resource.data;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt'])
    && d.version == 2 && d.kind in ['note','checkpoint'] && d.revision is int && d.revision >= 1 && d.updatedAt == request.time
    && cardId(d.deviceId) && d.operationId is string && d.operationId.size() > 0 && d.operationId.size() <= 300
    && validPersonal(d.payload,d.kind,id,d.deviceId);
  }
  match /users/{uid}/qualifications/{qualificationId}/personalV2/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && personalEnvelope(id) && request.resource.data.revision == 1;
   allow update: if mine(uid) && personalEnvelope(id) && request.resource.data.kind == resource.data.kind
    && request.resource.data.revision == resource.data.revision + 1;
   allow delete: if false;
  }
  function cardId(v) { return v is string && v.matches('[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}'); }
  function cardIds(v) { return v is list && v.size() > 0 && v.size() <= 200 && v.toSet().size() == v.size(); }
  function cardEnvelope(id) {
   let d=request.resource.data;
   let p=d.payload;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt'])
    && d.version == 2 && d.revision == 1 && d.operationId == id && d.updatedAt == request.time
    && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100
    && cardId(p.id) && id == d.kind + '--' + p.id
    && (d.kind == 'rating'
     ? p.keys().hasOnly(['id','cardId','cardVersion','outcome','at']) && cardId(p.cardId)
      && p.cardVersion is int && p.cardVersion > 0 && p.outcome in ['recalled','again']
      && p.at is string && p.at.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z')
     : (d.kind == 'reset' ? p.keys().hasOnly(['id','eventIds']) && cardIds(p.eventIds)
       : d.kind == 'restore' && p.keys().hasOnly(['id','eventIds','resetIds']) && cardIds(p.eventIds) && cardIds(p.resetIds)));
  }
  match /users/{uid}/qualifications/{qualificationId}/cardsV2/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && cardEnvelope(id);
   allow update, delete: if false;
  }
  function validCaseResponse(r) {
   let e=r.evaluation;
   let submitted=r.submittedAt;
   return r is map && r.keys().hasOnly(['value','submittedAt','evaluation','answerViewedBefore','skipped']) && r.value is string && r.value.size() <= 2000 && r.answerViewedBefore is bool
    && (!('skipped' in r) || r.skipped == true && r.value == '' && submitted is string)
    && (submitted == null ? e == null : submitted is string && (r.value.size() > 0 || 'skipped' in r))
    && (e == null || submitted is string && e.keys().hasOnly(['source','outcome','at','assisted']) && e.at is string && e.assisted == r.answerViewedBefore
      && (e.source == 'automatic' && e.outcome in ['correct','incorrect'] || e.source == 'self' && e.outcome in ['meets','partial','notYet','unsure']));
  }
  // Initial backup imports use bounded field shapes. Subsequent writes validate
  // the one changed response in full; the client also validates the full case.
  function validCaseSeedResponse(r) {
   return r is map && r.keys().hasOnly(['value','submittedAt','evaluation','answerViewedBefore','skipped']) && r.value is string && r.value.size() <= 2000;
  }
  function validCaseResponses(responses) {
   let keys=responses.keys();
   return responses.size() <= 20
    && (keys.size() <= 0 ? true : validCaseSeedResponse(responses[keys[0]]))
    && (keys.size() <= 1 ? true : validCaseSeedResponse(responses[keys[1]]))
    && (keys.size() <= 2 ? true : validCaseSeedResponse(responses[keys[2]]))
    && (keys.size() <= 3 ? true : validCaseSeedResponse(responses[keys[3]]))
    && (keys.size() <= 4 ? true : validCaseSeedResponse(responses[keys[4]]))
    && (keys.size() <= 5 ? true : validCaseSeedResponse(responses[keys[5]]))
    && (keys.size() <= 6 ? true : validCaseSeedResponse(responses[keys[6]]))
    && (keys.size() <= 7 ? true : validCaseSeedResponse(responses[keys[7]]))
    && (keys.size() <= 8 ? true : validCaseSeedResponse(responses[keys[8]]))
    && (keys.size() <= 9 ? true : validCaseSeedResponse(responses[keys[9]]))
    && (keys.size() <= 10 ? true : validCaseSeedResponse(responses[keys[10]]))
    && (keys.size() <= 11 ? true : validCaseSeedResponse(responses[keys[11]]))
    && (keys.size() <= 12 ? true : validCaseSeedResponse(responses[keys[12]]))
    && (keys.size() <= 13 ? true : validCaseSeedResponse(responses[keys[13]]))
    && (keys.size() <= 14 ? true : validCaseSeedResponse(responses[keys[14]]))
    && (keys.size() <= 15 ? true : validCaseSeedResponse(responses[keys[15]]))
    && (keys.size() <= 16 ? true : validCaseSeedResponse(responses[keys[16]]))
    && (keys.size() <= 17 ? true : validCaseSeedResponse(responses[keys[17]]))
    && (keys.size() <= 18 ? true : validCaseSeedResponse(responses[keys[18]]))
    && (keys.size() <= 19 ? true : validCaseSeedResponse(responses[keys[19]]));
  }
  function frozenCaseResponses(p,old) {
   let key=p.progress.lastResponseKey;
   let previous=key is string ? old.responses.get(key,null) : null;
   let next=key is string ? p.responses.get(key,null) : null;
   return p.responses == old.responses || key is string && p.responses.diff(old.responses).affectedKeys().hasOnly([key]) && next != null && validCaseResponse(next) && (previous == null || previous.submittedAt == null
    || next.value == previous.value && next.submittedAt == previous.submittedAt && next.answerViewedBefore == previous.answerViewedBefore && next.get('skipped',false) == previous.get('skipped',false) && (previous.evaluation == null || next.evaluation == previous.evaluation));
  }
  function validCase(p,id,qualificationId) {
   return qualificationId == 'ap' && p.keys().hasOnly(['format','version','kind','id','qualificationId','examPartId','caseId','caseVersion','material','mode','responses','assistance','progress','startedAt','updatedAt','completedAt'])
    && p.format == 'hitomon-learning-record' && p.version == 2 && p.kind == 'case' && p.id == id && id.matches('case--[a-zA-Z0-9_-]{1,90}') && p.qualificationId == qualificationId && p.examPartId == 'written'
    && p.caseId is string && p.caseVersion is int && p.caseVersion > 0 && p.mode in ['learning','exam']
    && p.material is map && p.material.status == 'reviewed' && p.material.id == p.caseId && p.material.version == p.caseVersion && p.material.qualificationId == qualificationId && p.material.examPartId == p.examPartId
    && p.material.body is string && p.material.body.size() <= 200000 && p.material.items is list && p.material.items.size() > 0 && p.material.items.size() <= 30
    && p.responses is map && p.responses.size() <= 20 && p.assistance.keys().hasOnly(['firstAnswerViewedAt','viewedFields']) && p.assistance.viewedFields is list && p.assistance.viewedFields.size() <= 600
    && (p.assistance.firstAnswerViewedAt == null || p.assistance.firstAnswerViewedAt is string)
    && p.progress.keys().hasOnly(['status','currentItemId','bodyScroll','questionScroll','pane','lastResponseKey']) && p.progress.status in ['in_progress','partially_completed','awaiting_evaluation','completed'] && p.progress.currentItemId is string && (p.progress.lastResponseKey == null || p.progress.lastResponseKey is string) && p.progress.pane in ['questions','body'] && p.progress.bodyScroll is number && p.progress.questionScroll is number && p.progress.questionScroll >= 0 && p.progress.questionScroll <= 10000000 && p.progress.bodyScroll >= 0 && p.progress.bodyScroll <= 10000000
    && p.startedAt is string && p.updatedAt is string && (p.progress.status == 'completed' ? p.completedAt is string : p.completedAt == null);
  }
  function caseEnvelope(id,qualificationId) {
   let d=request.resource.data;
   return d.keys().hasOnly(['version','kind','revision','operationId','deviceId','payload','updatedAt']) && d.version == 2 && d.kind == 'case' && d.revision is int && d.revision >= 1 && d.operationId is string && d.operationId.size() <= 300 && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 100 && d.updatedAt == request.time && validCase(d.payload,id,qualificationId);
  }
  function frozenCase(p,old) {
   return p.diff(old).affectedKeys().hasOnly(['responses','assistance','progress','updatedAt','completedAt'])
    && p.responses.diff(old.responses).removedKeys().size() == 0 && frozenCaseResponses(p,old)
    && (old.progress.status != 'completed' || p.responses == old.responses && p.completedAt == old.completedAt);
  }
  match /users/{uid}/qualifications/{qualificationId}/writtenV2/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && caseEnvelope(id,qualificationId) && request.resource.data.revision == 1 && (request.resource.data.payload.responses.size() == 0 || validCaseResponses(request.resource.data.payload.responses));
   allow update: if mine(uid) && caseEnvelope(id,qualificationId) && request.resource.data.revision == resource.data.revision + 1 && frozenCase(request.resource.data.payload,resource.data.payload);
   allow delete: if false;
  }
  match /users/{uid}/qualifications/{qualificationId}/attemptsV2/{id} {
   allow read: if mine(uid);
   allow create: if mine(uid) && envelope(id, qualificationId);
   allow update: if mine(uid) && envelope(id, qualificationId)
    && request.resource.data.deviceId == resource.data.deviceId
    && request.resource.data.revision > resource.data.revision
    && request.resource.data.payload.assistance.hintCount >= resource.data.payload.assistance.hintCount
    && request.resource.data.payload.material == resource.data.payload.material
    && request.resource.data.payload.lesson == resource.data.payload.lesson
    && request.resource.data.payload.startedAt == resource.data.payload.startedAt
    && request.resource.data.payload.questionId == resource.data.payload.questionId
    && (!completed(resource.data.payload) || request.resource.data.payload.diff(resource.data.payload).affectedKeys().hasOnly(['assistance','progress','updatedAt']) && request.resource.data.payload.assistance.answerViewedBefore == resource.data.payload.assistance.answerViewedBefore);
   // Removing local history is local only. Destructive cloud reset is not offered.
   allow delete: if false;
  }
 }
}
